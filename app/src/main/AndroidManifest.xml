<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      Asked at runtime (API 33+) at the moment a notification toggle is turned on, as iOS asks on
      the same gesture. Declared here on purpose even though firebase-messaging merges in an
      identical line: relying on a library's manifest merge for a permission the UI's behaviour
      depends on means it disappears silently the day that dependency moves.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      The Advertising ID the ads SDK reads. It is contributed by play-services-ads' own manifest,
      but declared here for the same reason POST_NOTIFICATIONS is: the app's behaviour should not
      depend on which library happens to be in the build.
    -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <application
        android:name=".NordPriceApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NordPrice">

        <!--
          Mandatory: the Mobile Ads SDK aborts during initialise without it, and it has to be an
          Android AdMob app id (the `~` form) — the iOS one is a different app record. What is here
          now is Google's sample app id, chosen so the debug test banners in AdPlacement resolve;
          both halves have to be replaced before a release build can serve real ads.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:theme="@style/Theme.NordPrice">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.NordPriceWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nordprice_widget_info" />
        </receiver>

        <!-- FCM delivery: onNewToken keeps the backend registration fresh, and this is the only
             path that can show an alert while the app is in the foreground. -->
        <service
            android:name=".notifications.NordPriceMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
          Stores the in-app language on Android 12 and below, where the system has no per-app
          locales. On Android 13+ the platform keeps it and this service stays disabled.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
