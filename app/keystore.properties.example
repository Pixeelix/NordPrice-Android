# Copy this to app/keystore.properties, fill it in, and keep it out of git (.gitignore already
# covers that file). Nothing else in the repo needs to change: app/build.gradle.kts reads it and
# signs the release variant with it automatically.
#
# Make the key once, outside the repository, with a password you store in a password manager:
#
#   keytool -genkeypair -v \
#     -keystore ~/.nordprice/nordprice-upload.jks \
#     -alias nordprice-upload \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# app/keystore.properties holds passwords, so use forward slashes even on the paths, and quote
# nothing.
#
# A relative storeFile resolves against app/.
storeFile=/Users/martinpi/.nordprice/nordprice-upload.jks
storePassword=change-me
keyAlias=nordprice-upload
keyPassword=change-me
