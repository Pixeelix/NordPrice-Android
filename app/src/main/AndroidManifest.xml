<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      Asked at runtime (API 33+) at the moment a notification toggle is turned on, as iOS asks on
      the same gesture. Declared here on purpose even though firebase-messaging merges in an
      identical line: relying on a library's manifest merge for a permission the UI's behaviour
      depends on means it disappears silently the day that dependency moves.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      The Advertising ID the Mobile Ads SDK reads. It is contributed by play-services-ads' own
      manifest too, but declared here for the same reason POST_NOTIFICATIONS is above: the app's
      behaviour should not depend on which library happens to be in the build. It is also what Play's
      Data Safety form has to describe — see README > Cutting a release.
    -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <application
        android:name=".NordPriceApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NordPrice">

        <!--
          Mandatory: the Mobile Ads SDK refuses to initialise without it. This is the AdMob record for
          the *Android* app (package com.koodipardik.nordprice, publisher 5431783362632568 — the same
          AdMob account as iOS, a different app, so none of the iOS unit ids belong here). An app id is
          not a secret: it is a public identifier that ships inside the APK, which is why it can sit in
          a tracked file while the upload keystore cannot.

          Debug never reads this line: app/src/debug/AndroidManifest.xml overrides it with Google's
          sample app id, which is the pair for the test unit id in AdPlacement.resolveUnitId.

          This value and the unit ids in AdPlacement are the two halves of one configuration:
          AdPlacement.isConfigured requires both, so an app id with no units (or the reverse) leaves the
          build ad-free instead of half-started. That pairing is the reason the units live in Kotlin and
          this lives here even though they name the same AdMob account.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-5431783362632568~3036192953" />

        <!--
          Auto-initialisation, switched off. play-services-ads contributes this provider itself, and a
          ContentProvider runs at process attach — before MainActivity.onResume, before
          ConsentManager.gatherConsent, and so before anyone has asked whether ads may be requested at
          all. Two things follow from that, and both are fixed by this one element:

          * Compliance. The SDK parsing its app id and starting up on every launch, consented or not, is
            the exact pattern GDPR enforcement targets; ConsentManager's rule that MobileAds only starts
            once canRequestAds says so was only half true while a library provider got there first.
          * Failure mode. The provider throws IllegalStateException ("Invalid application ID") on a
            placeholder or missing id, which is a crash on launch for a build that should simply be
            ad-free. With auto-init gone the id is only read by MobileAds.initialize, which
            AdPlacement.isConfigured keeps away from a build that has no real ids — so the unconfigured
            state is inert instead of fatal.

          The cost is that MobileAds.initialize must be called by hand and must finish first, which
          ConsentManager does on the consent callback before it publishes canRequestAds.
        -->
        <provider
            android:name="com.google.android.gms.ads.MobileAdsInitProvider"
            android:authorities="${applicationId}.mobileadsinitprovider"
            android:exported="false"
            android:initOrder="100"
            tools:node="remove" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:theme="@style/Theme.NordPrice">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.NordPriceWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nordprice_widget_info" />
        </receiver>

        <!-- FCM delivery: onNewToken keeps the backend registration fresh, and this is the only
             path that can show an alert while the app is in the foreground. -->
        <service
            android:name=".notifications.NordPriceMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
          Stores the in-app language on Android 12 and below, where the system has no per-app
          locales. On Android 13+ the platform keeps it and this service stays disabled.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
